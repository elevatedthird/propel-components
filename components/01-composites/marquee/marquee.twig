{# Marquee SDC. #}
{# Gap is programmatically set to make the transitions seamless. #}
{# Otherwise, a jump will happen when the animation resets. #}
{% set gap = gap|default(24) %}
{% set direction = direction|default('horizontal') %}
{% set reverse = reverse == true ? 'true' : 'false' %}

<div {{ attributes.addClass('marquee overflow-hidden relative')
  .setAttribute('data-reverse', reverse)
  .setAttribute('data-duration', duration|default(40000))
  .setAttribute('data-gap', gap)
  .setAttribute('data-direction', direction) }}>
  {% set classes = [
    'flex',
    'items-center',
    'justify-between',
    'shrink-0',
    direction == 'vertical' ? 'flex-col' : ''
  ] %}

  <div {{ focusable == true ? 'tabindex="0"' : '' }} class="marquee-wrapper {{ classes|join(' ') }}" style="gap:{{ gap }}px">
    <div class="marquee-items {{ classes|join(' ') }}" style="gap:{{ gap }}px">
      {# Should be an array of items to apply the animation to #}
      {{ items }}
    </div>
  </div>
</div>
