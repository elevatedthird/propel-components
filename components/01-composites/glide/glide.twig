{% set attributes = create_attribute().addClass(classes|default([])).addClass('glide') %}
{% if behavior_name %}
  {% set attributes = attributes.setAttribute('data-behavior-name', behavior_name) %}
{% endif %}

{% set attributes = attributes.setAttribute('data-slide-length', slide_count) %}

<div {{ attributes }}>
  {# Slides #}
  <div class="glide__track" data-glide-el="track">
    <ul class="glide__slides">
      {{ items }}
    </ul>
  </div>

  {# Glide bullets #}
  {% if controls %}
    {{ include('kinetic:glide-bullets', {
      bullet_classes: 'bg-primary icon-circle-sm',
      slide_count: slide_count
    }, with_context: false) }}
  {% endif %}

  {# Glide arrows #}
  {% if show_arrows %}
    {{ include('kinetic:glide-arrows', {
      arrow_right_classes: 'bg-primary rotate-90 icon-caret/md',
      arrow_left_classes: 'bg-primary rotate-270 icon-caret/md'
    }, with_context: false) }}
  {% endif %}
</div>
