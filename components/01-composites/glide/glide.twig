{% set attributes = create_attribute().addClass(classes|default([])).addClass('glide') %}
{% if behavior_name %}
  {% set attributes = attributes.setAttribute('data-behavior-name', behavior_name) %}
{% endif %}

{% set attributes = attributes.setAttribute('data-slide-length', slide_count) %}

<div {{ attributes }}>
  {# Slides #}
  <div class="glide__track" data-glide-el="track">
    <ul class="glide__slides">
      {% for item in slide_count %}
        <li class="glide__slide">
          {{ item }}
        </li>
      {% endfor %}
    </ul>
  </div>

  {# Glide bullets #}
  {% if bullets is defined %}
    {{ bullets }}
  {% endif %}

  {# Glide arrows #}
  {% if arrows is defined %}
    {{ arrows }}
  {% endif %}
</div>
