<div {{ attributes.addClass([
  'relative',
  'w-full',
  'h-[500px]',
  'overflow-hidden',
  'flex',
  'flex-col-reverse',
  'md:flex-row-reverse',
  'kinetic-banner'
]) }}>
  <div class="md:flex-2/5 px-4 py-10 md:pl-10 md:self-end">
    {% set props = {
      eyebrow: eyebrow,
      heading: heading,
    } %}
    {% if description is not empty %}
      {% set props = props|merge({ description: description}) %}
    {% endif %}
    {% if ctas is not empty %}
      {% set props = props|merge({ ctas: ctas}) %}
    {% endif %}
    {{ include('kinetic:section-intro', props, with_context: false) }}
  </div>
  <div aria-hidden="true" class="md:flex-3/5 h-full relative [&_img]:cover">
    {{ image }}
  </div>
</div>
