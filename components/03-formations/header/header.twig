<header {{ attributes.setAttribute('role', 'banner').setAttribute('id', 'paragon-header').addClass(['header', 'paragon-mega-menu']) }}>
  {% if header_top is defined %}
    <div class="bg-gray-900 py-2 d-none md:block">
      <div class="container-default flex justify-end">
        {{ header_top }}
      </div>
    </div>
  {% endif %}
  <div class='bg-gray-600 py-4'>
    <div class="container-default flex items-center justify-between">
      {{ branding }}
      <div class="d-none md:block">
        {{ main_menu }}
      </div>
      {# Mobile Menu Trigger #}
      <div class='block md:d-none'>
        {{ include('kinetic:menu-trigger', {
          aria_controls: 'mobile-nav-wrapper'
        }, with_context: false) }}
      </div>
    </div>
  </div>
  {# Mobile Menu Container. JS will clone blocks into here. #}
  <div id="mobile-nav-wrapper" class="bg-blue-overlay">
    <div class='mobile-nav__inner bg-gray-900'>
      <div class='container-default py-8'>
        <div data-block-collector='mobile'></div>
      </div>
  </div>
</header>
